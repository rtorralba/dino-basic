' =============================================================================
' DINO BASIC (.jbas)
' Código fuente estructurado sin números de línea y con etiquetas
' =============================================================================

' --- INICIALIZACION ---
LET py=0: LET oldpy=0: LET c1=0: LET c2=0: LET c3=0: LET j=0: LET sc=0: LET pt=0: LET nx=0: LET nc=0: LET kx=0: LET kc=0
LET y$ = CHR$ 19 + CHR$ 17 + CHR$ 16 + CHR$ 16 + CHR$ 17 + CHR$ 19 + CHR$ 20
LET hs=0
LET c$ = CHR$ 17 + CHR$ 4 + " " + CHR$ 17 + CHR$ 1 + " "
LET p$  = CHR$ 17 + CHR$ 3 + CHR$ 16 + CHR$ 2 + CHR$ 18 + CHR$ 1 + " " + CHR$ 17 + CHR$ 1 + CHR$ 18 + CHR$ 0 + " "
LET f$=""
FOR i=1 TO 16
LET f$=f$+CHR$ 17+CHR$ 6+CHR$ 16+CHR$ 7+CHR$ 19+CHR$ 0+CHR$ 18+CHR$ 1+" "+CHR$ 17+CHR$ 7+CHR$ 16+CHR$ 6+CHR$ 19+CHR$ 0+CHR$ 18+CHR$ 1+" "
NEXT i
GO TO @pantalla_inicio

@bucle_principal:
    LET oldpy=py

    ' Teclado / mando
   IF PEEK 23560 THEN POKE 23560,0: IF j=0 THEN LET j=1

    ' Salto
    IF j>0 THEN LET py=CODE y$(j): LET j=j+1: IF j>7 THEN LET j=0

@mover_cactus:
    LET c1=c1-1: LET c2=c2-1: IF sc>300 THEN LET c3=c3-1

    ' Si un cactus sale de pantalla, reaparece aleatoriamente detras del otro
    IF c1<0 THEN PRINT AT 20,0; " ": LET c1=c2+31+INT (RND*6)
    IF c2<0 THEN PRINT AT 20,0; " "; AT 16,0; " ":LET c2=c1+gp: IF sc>400 THEN LET pt=1
    IF c3<0 THEN PRINT AT 20,0; " ": LET c3=c2+gp

    ' Dibujamos los cactus SOLO si ya han entrado en la pantalla
    IF c1<31 THEN PRINT AT 20,c1; c$
    IF c2<31 THEN PRINT AT 20,c2; c$
    IF c3<31 THEN IF sc>300 THEN PRINT AT 20,c3; c$
    IF pt THEN IF c2<31 THEN PRINT AT 16,c2; p$

    ' Dibujamos el dino
    IF py<>oldpy THEN PRINT AT oldpy,5; " ";AT py,5; PAPER 2;" "

    ' Colisiones
    IF c1=5 OR c2=5 THEN GO TO @hay_obstaculo
    IF sc>300 THEN IF c3=5 THEN GO TO @hay_obstaculo
    IF pt THEN IF c2=5 THEN IF py=16 THEN GO TO @game_over
    GO TO @fin_colision
    @hay_obstaculo:
        IF py=20 THEN GO TO @game_over
        LET sc=sc+1: BORDER 6: GO SUB @actualizarMarcadorYDificultad: BORDER 3
    @fin_colision:

    LET nc=nc+1: IF nc=4 THEN LET nc=0: LET nx=nx-1: GO SUB @redibujar_nube
    LET kc=kc+1: IF kc=8 THEN LET kc=0: LET kx=kx-1: GO SUB @redibujar_nube_pequena

    GO TO @bucle_principal

@actualizarMarcadorYDificultad:
    ' 1. Unidades: cambian en cada punto y se imprimen siempre
    LET u = sc - INT (sc/10)*10
    LET dig = u: LET col = 5: GO SUB @imprimirDigito

    ' 2. Decenas: SOLO se imprimen si cambian (u=0) o al inicio (sc=0)
    IF u = 0 THEN LET dig = INT ((sc - INT (sc/100)*100)/10): LET col = 1: GO SUB @imprimirDigito

    IF sx>0 THEN IF sc=sm THEN LET sx=sx-1: LET sm=sm+3: GO SUB @redibujar_sol

    ' Actualiza dificultad
    IF sc>20 THEN LET gp=4: RETURN
    IF sc>15 THEN LET gp=5: RETURN
    IF sc>5 THEN LET gp=8: RETURN
    RETURN

@imprimirDigito:
    IF dig=0 THEN PRINT AT 1,col; PAPER 2;"   "; AT 2,col;" "; PAPER 1;" "; PAPER 2;" "; AT 3,col;" "; PAPER 1;" "; PAPER 2;" "; AT 4,col;" "; PAPER 1;" "; PAPER 2;" "; AT 5,col;"   ": RETURN
    IF dig=1 THEN PRINT AT 1,col; PAPER 1;" "; PAPER 2;" "; PAPER 1;" "; AT 2,col;" "; PAPER 2;" "; PAPER 1;" "; AT 3,col;" "; PAPER 2;" "; PAPER 1;" "; AT 4,col;" "; PAPER 2;" "; PAPER 1;" "; AT 5,col;" "; PAPER 2;" "; PAPER 1;" ": RETURN
    IF dig=2 THEN PRINT AT 1,col; PAPER 2;"   "; AT 2,col; PAPER 1;"  "; PAPER 2;" "; AT 3,col;"   "; AT 4,col;" "; PAPER 1;"  "; AT 5,col; PAPER 2;"   ": RETURN
    IF dig=3 THEN PRINT AT 1,col; PAPER 2;"   "; AT 2,col; PAPER 1;"  "; PAPER 2;" "; AT 3,col;"   "; AT 4,col; PAPER 1;"  "; PAPER 2;" "; AT 5,col;"   ": RETURN
    IF dig=4 THEN PRINT AT 1,col; PAPER 2;" "; PAPER 1;" "; PAPER 2;" "; AT 2,col;" "; PAPER 1;" "; PAPER 2;" "; AT 3,col;"   "; AT 4,col; PAPER 1;"  "; PAPER 2;" "; AT 5,col; PAPER 1;"  "; PAPER 2;" ": RETURN
    IF dig=5 THEN PRINT AT 1,col; PAPER 2;"   "; AT 2,col;" "; PAPER 1;"  "; AT 3,col; PAPER 2;"   "; AT 4,col; PAPER 1;"  "; PAPER 2;" "; AT 5,col;"   ": RETURN
    IF dig=6 THEN PRINT AT 1,col; PAPER 2;"   "; AT 2,col;" "; PAPER 1;"  "; AT 3,col; PAPER 2;"   "; AT 4,col;" "; PAPER 1;" "; PAPER 2;" "; AT 5,col;"   ": RETURN
    IF dig=7 THEN PRINT AT 1,col; PAPER 2;"   "; AT 2,col; PAPER 1;"  "; PAPER 2;" "; AT 3,col; PAPER 1;"  "; PAPER 2;" "; AT 4,col; PAPER 1;"  "; PAPER 2;" "; AT 5,col; PAPER 1;"  "; PAPER 2;" ": RETURN
    IF dig=8 THEN PRINT AT 1,col; PAPER 2;"   "; AT 2,col;" "; PAPER 1;" "; PAPER 2;" "; AT 3,col;"   "; AT 4,col;" "; PAPER 1;" "; PAPER 2;" "; AT 5,col;"   ": RETURN
    IF dig=9 THEN PRINT AT 1,col; PAPER 2;"   "; AT 2,col;" "; PAPER 1;" "; PAPER 2;" "; AT 3,col;"   "; AT 4,col; PAPER 1;"  "; PAPER 2;" "; AT 5,col; PAPER 1;"  "; PAPER 2;" ": RETURN
    RETURN

@game_over:
    IF sc>hs THEN LET hs=sc
    PRINT AT py,5; PAPER 2; INK 4; FLASH 1;" "
    BEEP 0.15,4: BEEP 0.15,0: BEEP 0.15,-3: BEEP 0.4,-8
    GO SUB @menu
    PRINT AT 12,7; PAPER 7;"  HIGH SCORE:  "; hs
    PAUSE 1: PAUSE 0
    GO TO @reinicio

@reinicio:
    BORDER 3: PAPER 1: INK 0: CLS
    PRINT AT 21,0; f$; FLASH 0
    ' sc=puntos, c1 y c2=cactus, pt=pterodactilo, py=jugador, j=salto, sx=x de sol, sm=puntos para siguiente movimiento del sol
    LET sc=0: LET gp=12: LET c1=31: LET c2=c1+gp: LET c3=c2+gp: LET pt=0: LET py=20: LET j=0: LET sm=3: LET nc=0: LET kc=0: LET dig=0: POKE 23560,0
    PRINT AT 20,5; PAPER 2;" "
    LET sx=29: LET nx=22: LET kx=8
    GO SUB @actualizarMarcadorYDificultad
    GO SUB @redibujar_sol
    GO SUB @redibujar_nube
    GO SUB @redibujar_nube_pequena
    GO TO @bucle_principal

@redibujar_sol:
    PRINT AT 6,0; PAPER 1;"  ";AT 7,0; PAPER 1;"  "
    PRINT AT 6,sx; PAPER 6;"  "; PAPER 1;" ";AT 7,sx; PAPER 6;"  "; PAPER 1;" "
    RETURN

@redibujar_nube:
    IF nx<0 THEN PRINT AT 13,0; PAPER 1;"    "; AT 14,0; PAPER 1;"     ": LET nx=27
    PRINT AT 13,nx+1; PAPER 7;"  "; PAPER 1;" "; AT 14,nx; PAPER 7;"    "; PAPER 1;" "
    RETURN

@redibujar_nube_pequena:
    IF kx<0 THEN PRINT AT 9,0; PAPER 1;"   "; AT 10,0; PAPER 1;"    ": LET kx=28
    PRINT AT 9,kx+1; PAPER 7;" "; PAPER 1;" "; AT 10,kx; PAPER 7;"   "; PAPER 1;" "
    RETURN

@pantalla_inicio:
    BORDER 3: PAPER 1: INK 0: CLS
    GO SUB @menu
    PAUSE 0
    GO TO @reinicio

@menu:
    PRINT AT 7,7; PAPER 7;  "                   "
    PRINT AT 8,7; PAPER 7;  "    DINO BASIC     "
    PRINT AT 9,7; PAPER 7;  "                   "
    PRINT AT 10,7; PAPER 7; "  PULSA UNA TECLA  "
    PRINT AT 11,7; PAPER 7; "                   "
    PRINT AT 12,7; PAPER 7; "   HIGH SCORE: 0   "
    PRINT AT 13,7; PAPER 7; "                   "
    RETURN